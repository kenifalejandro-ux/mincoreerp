STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

ENV_FILES=$(echo "$STAGED_FILES" | { grep -E '(^|/)\.env(\..+)?$' || true; } | { grep -v '\.env\.example$' || true; })
if [ -n "$ENV_FILES" ]; then
  echo "Commit bloqueado: archivo(s) .env en el commit (solo .env.example esta permitido):"
  echo "$ENV_FILES"
  exit 1
fi

echo "$STAGED_FILES" | xargs -r npx secretlint --secretlintrc .secretlintrc.json || exit 1

npx lint-staged || exit 1

# Los tipos (tsc) no se revisan acá: los revisa el pre-push (npm run verificar)
# y el CI. Correrlos en cada commit sumaba ~1 min cada vez.
