# Puerta antes de subir (scripts/verificar.ts): formato, lint, tipos y tests
# del módulo tocado contra una base desechable, y el e2e SOLO de los specs que
# creaste o modificaste, 5 veces en chromium. El resto de los e2e los corre el
# CI. Omitir es decisión consciente: SKIP_VERIFICAR=1 git push
# (o SKIP_E2E=1 si no hay Docker).
npm run verificar || {
  echo ""
  echo "Push bloqueado: arreglá lo marcado con 'ERROR EN' y volvé a intentar."
  exit 1
}
