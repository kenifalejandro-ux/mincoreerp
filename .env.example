NODE_ENV=development
PORT=3000

# Tamaño máximo del cuerpo de un request. El general es chico a propósito
# (acota cuánta memoria puede hacer reservar un request cualquiera); el de
# carga masiva aplica SOLO a las rutas que terminan en /bulk, que reciben
# una planilla entera. Con el límite general, la importación se cortaba a
# ~110 filas con un 413. El tope de FILAS es aparte, en los schemas de Zod.
BODY_LIMIT=16kb
BULK_BODY_LIMIT=2mb

# JWT — obligatorio, el server no arranca sin esto (ver src/server/config/env.ts).
# Genera uno fuerte: openssl rand -base64 48
JWT_SECRET=
# Corto a propósito: la revocación real la hace token_version (columna en
# usuarios, ver migrations/0003_token_version.sql), no la expiración del JWT.
JWT_EXPIRES=30m
# También es la vida del refresh token (cookie "{AUTH_COOKIE_NAME}_refresh",
# tabla refresh_tokens) — cuánto puede durar una sesión renovándose sola
# antes de forzar login otra vez. Ver POST /api/auth/refresh.
SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=erp_token

# "Continuar con Google" — opcional. Sin esto, el botón simplemente no se
# muestra en el login y POST /api/auth/google responde 503. Crea un OAuth
# Client ID de tipo "Web application" en Google Cloud Console y agrega el
# origen (http://localhost:5174 en dev) a "Authorized JavaScript origins".
GOOGLE_LOGIN_CLIENT_ID=

# Base del link en el correo de recuperación de contraseña, cuando el
# tenant no tiene dominio propio ni subdominio de plataforma configurado.
APP_PUBLIC_URL=http://localhost:5174

# PostgreSQL — el usuario debe ser owner de las tablas de la app (no postgres),
# para poder correr ALTER TABLE en migraciones futuras sin sudo.
# Obligatorias solo si NO defines DATABASE_URL (ver env.ts: pgVarsRequeridas).
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# Railway u otro proveedor gestionado inyecta esta variable en vez de las
# PG_* individuales — database.ts la detecta automáticamente y, si está
# presente, las PG_* dejan de ser obligatorias.
# DATABASE_URL=

# Redis (sesiones + rate limiting + cache). Sin esto, ambos caen a un
# fallback en memoria — funcional en local, no recomendable en producción
# con más de una instancia del server.
# REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS — orígenes permitidos en producción, separados por coma
# (en desarrollo se permite cualquier origen automáticamente)
ALLOWED_ORIGINS=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Rate limit de las rutas de negocio (/api/erp/*), en DOS niveles. Distinto
# del de arriba: aquél cuenta por ruta (fuerza bruta contra un endpoint),
# éstos son presupuestos de tráfico. Cualquiera en 0 desactiva ese nivel.
#
# Se cuenta por USUARIO, no por IP: los operarios en oficina comparten el
# NAT de la empresa y los de planta usan datos móviles (CGNAT + IP que
# cambia al moverse entre antenas), así que la IP no identifica a nadie.
# Además este middleware corre después de la autenticación, así que nunca
# ve tráfico anónimo — siempre hay un usuario identificado detrás.
ERP_RATE_LIMIT_WINDOW_MS=60000
# Fusible por persona: atrapa un script en loop o una cuenta comprometida.
# No varía por plan — un operario hace clic igual de rápido en una MYPE que
# en una Corporativo.
ERP_RATE_LIMIT_USUARIO_MAX=120
# Techo de la empresa POR DEFECTO: protege a los DEMÁS clientes de un tenant
# desbocado. Es el fallback — cada tenant puede tener su propio número, que
# se configura desde el panel (recurso 'rate_limit_rpm') con el tráfico real
# medido a la vista, en vez de adivinarlo.
ERP_RATE_LIMIT_TENANT_DEFAULT=3000

# Email (alertas / notificaciones del ERP)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
# Envío por API de Brevo (https://app.brevo.com). Con BREVO_API_KEY puesta se usa
# esta vía en lugar del SMTP: necesaria en Railway plan Hobby, que bloquea el
# SMTP saliente. EMAIL_FROM debe ser una dirección de un dominio verificado
# en Brevo (ej. alertas@mincoreerp.com.pe). Sin EMAIL_FROM usa EMAIL_USER.
BREVO_API_KEY=
EMAIL_FROM=

# reCAPTCHA — protege /api/auth/login en producción
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Onboarding de tenants (POST /api/platform/tenants) — separado del login
# normal a propósito, es una operación tuya como dueño del ERP, no de un
# usuario de un tenant. Sin esto configurado, el endpoint responde 503.
# Genera uno fuerte: openssl rand -base64 48
PLATFORM_ADMIN_TOKEN=

# Cuánto dura la sesión de login por cookie del panel (platformSession.service.ts)
PLATFORM_SESSION_TTL_MS=43200000

# Rate limits específicos del panel de plataforma — separados del genérico
# de arriba porque comparten Redis con TODO lo demás (incluidos tests si
# corren contra el mismo Redis): si tu suite crea muchos tenants/logins de
# admin seguidos, subí estos dos en tu .env local (nunca en producción).
PLATFORM_TENANT_CREATION_WINDOW_MS=900000
PLATFORM_TENANT_CREATION_MAX_REQUESTS=5
PLATFORM_ADMIN_LOGIN_WINDOW_MS=900000
PLATFORM_ADMIN_LOGIN_MAX_REQUESTS=10
# Complementan al rateLimiter genérico (por IP) en /login y /forgot-password
# -- estos son por tenantSlug+email, para que un ataque repartido entre
# varias IPs contra UNA cuenta no se escape del límite por IP.
LOGIN_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
LOGIN_EMAIL_RATE_LIMIT_MAX_REQUESTS=10
FORGOT_PASSWORD_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_EMAIL_RATE_LIMIT_MAX_REQUESTS=10

# ─── BACKUPS ────────────────────────────────────────────────────────────
# Guía completa: docs/architecture/backups-s3.md
#
# Dónde vive el contenido de los backups de tenant (platformBackup.service.ts)
# — filesystem local por default. Contiene datos reales de clientes
# (incluidos password_hash): protegé este directorio igual que la base de
# datos, nunca lo sirvas por una ruta estática.
BACKUPS_DIR=./backups

# Cifrado del lado del CLIENTE, antes de subir (AES-256-GCM + gzip).
# OBLIGATORIO con BACKUP_STORAGE_DRIVER=s3: sin esto el export falla con 503
# en vez de mandar password_hash sin cifrar a storage de un tercero.
# Con driver local es opcional (los backups viejos sin cifrar se siguen
# pudiendo restaurar), pero se avisa por log en cada backup.
# Separada de APP_ENCRYPTION_KEY a propósito: un backup tiene que poder
# restaurarse en un entorno de DR donde esa otra clave ya rotó.
# Generala con: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=

# "local" (default) o "s3". Solo decide dónde se ESCRIBE lo nuevo: cada
# backup recuerda con qué driver se guardó, así migrar a S3 no vuelve
# irrestaurable lo que ya está en disco.
#
# ⚠ EN PRODUCCIÓN TIENE QUE SER "s3". Con "local" los backups van al disco
# del contenedor, y en un PaaS sin volumen montado (Railway, Fly, Heroku)
# ese disco se descarta en CADA deploy: el backup desaparece sin que nada
# falle ni lo avise. Un backup que no sobrevive a un deploy no es un
# backup, y el modo de fallo es el peor posible — te enterás el día que lo
# necesitás. Vale igual para DOCUMENTOS_STORAGE_DRIVER, más abajo.
BACKUP_STORAGE_DRIVER=local

# S3 (o compatible). Hacen falta con BACKUP_STORAGE_DRIVER=s3 y/o con
# DOCUMENTOS_STORAGE_DRIVER=s3 — un mismo bucket sirve para los dos, van en
# prefijos distintos ("backups/" y "documentos/").
#
# Valores verificados contra Cloudflare R2 (probado de punta a punta con
# `npm run storage:verificar`):
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (SIN el bucket al final)
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=true
#   S3_SERVER_SIDE_ENCRYPTION=      <- VACÍO: R2 ya cifra en reposo y rechaza el header
# El token de R2 alcanza con permiso "Object Read & Write"; NO uses el de
# Administrador, que además puede borrar buckets enteros.
S3_BUCKET_NAME=
S3_REGION=us-east-1
# Vacío = AWS real. Seteado = Cloudflare R2 / MinIO / Backblaze B2, que
# además suelen necesitar S3_FORCE_PATH_STYLE=true.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Vacías = el SDK usa su cadena estándar de credenciales (IAM role de la
# instancia/task, ~/.aws/credentials...). Preferible en AWS real: evita
# tener secretos de larga vida en el entorno.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cifrado del lado del SERVIDOR que se le pide a S3, ADEMÁS del de cliente.
# "AES256" (SSE-S3) por default; "aws:kms" requiere S3_SSE_KMS_KEY_ID.
# Vaciala si tu proveedor S3-compatible rechaza el header.
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_SSE_KMS_KEY_ID=

# Retención automática de backups (platformBackupRetention.worker.ts).
# Las DOS tienen que ser > 0 para que el worker borre algo; en 0 (el default
# del CÓDIGO, a propósito: activar un borrado automático es una decisión de
# negocio) no borra NADA. Política: se conservan todos los backups de los
# últimos BACKUP_RETENTION_DIARIO_DIAS días, y de ahí en más solo el
# primero de cada mes hasta BACKUP_RETENTION_MENSUAL_MESES meses atrás.
#
# ── Por qué 90 días ─────────────────────────────────────────────────────
#
# NO es un requisito legal. La retención legal (Ley 29783 y su reglamento,
# para los registros de seguridad que guarda el ERP) aplica a la DATA VIVA,
# que no se borra nunca — un IPERC de hace tres años sigue en su tabla. Los
# backups son otra cosa: son para REBOBINAR, no para archivar.
#
# Lo que fija el número es la ventana de detección: ¿cuánto puede pasar
# hasta que alguien note que algo se rompió? Un error ruidoso (una migración
# que falla) se ve en horas. Una corrupción SILENCIOSA —un UPDATE sin WHERE
# sobre una tabla que nadie mira seguido— puede tardar semanas, y ahí hace
# falta un backup ANTERIOR al daño. 90 días cubre ese caso con holgura.
#
# El costo no es la restricción: los backups van comprimidos y cifrados
# (~500 KB por tenant con datos reales), así que 90 diarios + 12 mensuales
# son ~1 GB con 20 tenants, contra 10 GB gratis en R2. Siendo el costo
# marginal, no hay motivo para acortar la ventana.
#
# OJO: dejar esto en 0 con driver "s3" hace que los backups se acumulen sin
# techo. Hoy eso pasa desapercibido con driver "local" porque el disco
# efímero los borra solo en cada deploy — un accidente, no una política.
BACKUP_RETENTION_DIARIO_DIAS=90
BACKUP_RETENTION_MENSUAL_MESES=12
BACKUP_RETENTION_CHECK_INTERVAL_MS=86400000

# Archivos del módulo Documentos (PDF/imagen adjunto por documento).
# "local" (default, dev/tests) o "s3" -- con "s3" reusa el mismo bucket y
# credenciales S3_* de arriba, bajo el prefijo "documentos/" (no hace falta
# bucket ni credenciales aparte de las de backups).
#
# ⚠ EN PRODUCCIÓN TIENE QUE SER "s3", por lo mismo que BACKUP_STORAGE_DRIVER
# (ver arriba): con "local" sobre un contenedor sin volumen, el PDF que
# sube un cliente desaparece en el próximo deploy. Acá es peor que con los
# backups, porque el archivo es del cliente y su fila en documentos_versiones
# sigue existiendo — la UI le muestra una versión que ya no se puede bajar.
#
# Verificá que quedó bien configurado con:  npm run storage:verificar
DOCUMENTOS_STORAGE_DRIVER=local
DOCUMENTOS_DIR=./documentos_archivos

# Restore drill de ESCRITURA (platformBackupWriteDrill.worker.ts): a
# diferencia del drill de lectura (que corre siempre, no tiene env var),
# este SÍ inserta filas de verdad — sobre un tenant descartable, dentro de
# una transacción que nunca comitea. Apagado por default; activalo cuando
# quieras que se pruebe periódicamente el camino real de restore, no solo
# que el archivo se pueda leer y descifrar.
BACKUP_WRITE_DRILL_ENABLED=false
BACKUP_WRITE_DRILL_CHECK_INTERVAL_MS=604800000

# Cifrado reversible de secretos de plataforma (hoy: el client_secret OIDC
# de cada tenant con SSO configurado, ver platformCrypto.ts). Sin esto,
# guardar o usar un SSO de tenant responde 503 — no bloquea el arranque del
# server porque no todos los despliegues necesitan SSO. Separado a
# propósito de JWT_SECRET (cifrar vs firmar son cosas distintas).
# Genera uno: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# SSO de Platform Admin — un solo proveedor OIDC global (a diferencia del
# SSO por tenant, que se configura por empresa desde el panel). Opcional:
# sin esto, el botón de SSO simplemente no aparece en /plataforma.
PLATFORM_SSO_ISSUER_URL=
PLATFORM_SSO_CLIENT_ID=
PLATFORM_SSO_CLIENT_SECRET=

# Monitoreo de errores (config/sentry.ts). Vacío por default: Sentry no se
# inicializa, capturarError() queda como no-op, y toda la app funciona
# exactamente igual que hoy. Sin esto, un crash de un worker en producción
# solo queda en los logs -- nadie se entera hasta que un cliente se queja.
# Crear un proyecto en sentry.io (o donde sea) y pegar acá su DSN lo activa.
SENTRY_DSN=
# Separa los eventos de dev/staging/producción dentro del mismo proyecto de
# Sentry. Si no se setea, usa NODE_ENV ("production" o "development").
SENTRY_ENVIRONMENT=

# Pasarela de pago (billing, migración 0041). Vacío: obtenerPasarelaPago()
# usa StubPasarela (desarrollo/tests, sin llamadas externas) -- ver
# pasarelaPago.ts. Recién hace falta cargar esto para cobrar de verdad.
CULQI_SECRET_KEY=
# No se usa todavía (no hay checkout de tarjeta en el frontend en este P0),
# documentado para cuando exista.
CULQI_PUBLIC_KEY=
# Culqi no firma sus webhooks con HMAC -- este es el secreto compartido que
# se exige en el header X-Culqi-Webhook-Secret (ver pasarelaPagoCulqi.ts).
CULQI_WEBHOOK_SECRET=
