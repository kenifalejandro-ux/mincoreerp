{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/raiz.tsbuildinfo"
  },
  "include": [
    "server.ts",
    "migrate.ts",
    "src/server/**/*.ts",
    "src/server/**/*.d.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "app.ts"
  ],
  "exclude": ["node_modules", "client/node_modules", "client/src"]
}
